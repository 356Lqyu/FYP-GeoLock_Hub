-- Operator-authorized credential setting for this new restricted login ONLY.
-- No password/verifier is written in this file or captured by the runner.
\set ON_ERROR_STOP on
BEGIN READ ONLY;
SELECT current_database()='postgres' AND current_user='postgres' AND session_user='postgres'
 AND (SELECT enabled FROM resolution_private.config WHERE singleton) IS FALSE
 AND EXISTS(SELECT 1 FROM pg_roles WHERE rolname='geolock_resolution_operator_login'
 AND rolcanlogin AND NOT rolinherit AND NOT rolsuper AND NOT rolcreatedb
 AND NOT rolcreaterole AND NOT rolreplication AND NOT rolbypassrls)
 AND EXISTS(SELECT 1 FROM resolution_private.operators
 WHERE login_name='geolock_resolution_operator_login'
 AND operator_label='GeoLock DEV resolution operator - project owner' AND active)
 AND EXISTS(SELECT 1 FROM pg_auth_members
 WHERE member='geolock_resolution_operator_login'::regrole
 AND roleid='geolock_route_resolver'::regrole
 AND NOT admin_option AND NOT inherit_option AND set_option)
 AS password_target_ok \gset
\if :password_target_ok
\else
ROLLBACK;
\quit 3
\endif
ROLLBACK;
\password geolock_resolution_operator_login
