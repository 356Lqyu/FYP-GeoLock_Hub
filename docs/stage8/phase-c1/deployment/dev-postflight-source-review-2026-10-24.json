      "definition": "CHECK ((((vehicle_type IS NULL) OR ((length(btrim(vehicle_type)) >= 1) AND (length(btrim(vehicle_type)) <= 80))) AND (payload_capacity_kg <> ALL (ARRAY['NaN'::numeric, 'Infinity'::numeric, '-Infinity'::numeric])) AND ((fixed_cost_rm IS NULL) OR ((fixed_cost_rm >= (0)::numeric) AND (fixed_cost_rm < 'Infinity'::numeric) AND (scale(fixed_cost_rm) <= 2))) AND ((distance_cost_rm_per_km IS NULL) OR ((distance_cost_rm_per_km >= (0)::numeric) AND (distance_cost_rm_per_km < 'Infinity'::numeric) AND (scale(distance_cost_rm_per_km) <= 4))) AND ((max_route_duration_min IS NULL) OR ((max_route_duration_min > (0)::numeric) AND (max_route_duration_min < 'Infinity'::numeric) AND (scale(max_route_duration_min) <= 3))) AND (vehicle_version > 0)))",
      "table_name": "vehicles",
      "convalidated": true
    }
