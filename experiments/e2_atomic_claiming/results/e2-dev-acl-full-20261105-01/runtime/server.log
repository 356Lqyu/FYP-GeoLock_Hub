	   t.tgenabled='O' AND t.tgqual IS NULL AND t.tgnargs=0 AND t.tgattr::text='' AND (
	    (t.tgname='trg_listing_transition' AND t.tgtype=19 AND t.tgfoid=to_regprocedure('public.enforce_listing_transition()')) OR
	    (t.tgname='zz_listing_eligibility_generation' AND t.tgtype=23 AND t.tgfoid=to_regprocedure('public.geolock_prepare_listing_eligibility()')) OR
	    (t.tgname='trg_listing_road_eligibility' AND t.tgtype=21 AND t.tgfoid=to_regprocedure('public.geolock_listing_eligibility_trigger()')))))
	 OR NOT EXISTS(SELECT 1 FROM pg_trigger WHERE tgrelid='public.listings'::regclass AND tgname='trg_listing_transition' AND NOT tgisinternal)
	 OR md5((SELECT replace(prosrc,chr(13),'') FROM pg_proc WHERE oid='public.enforce_listing_transition()'::regprocedure))<>'c65f4b675734d8c28816066ea9f05603'
	 THEN RAISE EXCEPTION 'LISTING_TRIGGER_DRIFT'; END IF;
	 IF (SELECT count(*) FROM pg_trigger WHERE tgrelid='public.listings'::regclass AND NOT tgisinternal)=3 THEN
	 IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('public.geolock_prepare_listing_eligibility()') AND proowner='postgres'::regrole AND prosecdef AND md5(replace(prosrc,chr(13),''))='3c497b7081433cefc548ac8761347096') THEN RAISE EXCEPTION 'ELIGIBILITY_TRIGGER_DEPENDENCY_DRIFT: geolock_prepare_listing_eligibility'; END IF;
	 IF NOT EXISTS(SELECT 1 FROM pg_proc WHERE oid=to_regprocedure('public.geolock_listing_eligibility_trigger()') AND proowner='postgres'::regrole AND prosecdef AND md5(replace(prosrc,chr(13),''))='623342a706a4ca4e0a607fba4ffbf7e1') THEN RAISE EXCEPTION 'ELIGIBILITY_TRIGGER_DEPENDENCY_DRIFT: geolock_listing_eligibility_trigger'; END IF;
	 END IF;
	 target:='public.claim_listing(uuid,uuid)'::regprocedure;
	 SELECT pg_get_functiondef(oid),replace(prosrc,chr(13),''),to_jsonb(fn)-'prosrc' INTO definition,old_body,meta FROM pg_proc fn WHERE oid=target;
	 IF (length(definition)-length(replace(definition,'select * into v_l from public.listings where listing_id=p_listing for update;','')))/length('select * into v_l from public.listings where listing_id=p_listing for update;')<>1 THEN RAISE EXCEPTION 'EXACT_ANCHOR_DRIFT'; END IF;
	 EXECUTE replace(definition,'select * into v_l from public.listings where listing_id=p_listing for update;','select * into v_l from public.listings where listing_id=p_listing for no key update;');
	 SELECT replace(prosrc,chr(13),''),to_jsonb(fn)-'prosrc' INTO new_body,actual FROM pg_proc fn WHERE oid=target;
	 IF new_body IS DISTINCT FROM replace(old_body,'select * into v_l from public.listings where listing_id=p_listing for update;','select * into v_l from public.listings where listing_id=p_listing for no key update;') OR md5(new_body)<>'c8d324772b12c843fba231e7ea733914' OR actual IS DISTINCT FROM meta THEN RAISE EXCEPTION 'PATCH_POSTCONDITION_FAILED'; END IF;
	 target:='public.geolock_lock_listing_donations(uuid,text[])'::regprocedure;
	 SELECT pg_get_functiondef(oid),replace(prosrc,chr(13),''),to_jsonb(fn)-'prosrc' INTO definition,old_body,meta FROM pg_proc fn WHERE oid=target;
	 IF (length(definition)-length(replace(definition,'select * into v_l from public.listings where listing_id=p_listing for update;','')))/length('select * into v_l from public.listings where listing_id=p_listing for update;')<>1 THEN RAISE EXCEPTION 'EXACT_ANCHOR_DRIFT'; END IF;
	 EXECUTE replace(definition,'select * into v_l from public.listings where listing_id=p_listing for update;','select * into v_l from public.listings where listing_id=p_listing for no key update;');
	 SELECT replace(prosrc,chr(13),''),to_jsonb(fn)-'prosrc' INTO new_body,actual FROM pg_proc fn WHERE oid=target;
	 IF new_body IS DISTINCT FROM replace(old_body,'select * into v_l from public.listings where listing_id=p_listing for update;','select * into v_l from public.listings where listing_id=p_listing for no key update;') OR md5(new_body)<>'e97a3fd80673a827465f3eaa79b65903' OR actual IS DISTINCT FROM meta THEN RAISE EXCEPTION 'PATCH_POSTCONDITION_FAILED'; END IF;
	END $coordinated_lock_patch$;
	COMMIT;
	
