xtra_float_digits=0"]}, "routing_private.lock_sources(uuid[])": {"hash": "52dc6262f3f85bd3c67a787401cf71aa", "owner": "postgres", "definer": true, "acl": "{postgres=X/postgres}", "config": ["search_path=pg_catalog, pg_temp", "TimeZone=UTC", "extra_float_digits=0"]}, "public.start_pickup(uuid)": {"hash": "cb306433867538804b67aa1a242867b4", "owner": "postgres", "definer": true, "acl": "{postgres=X/postgres,authenticated=X/postgres}", "config": ["search_path=pg_catalog, pg_temp", "TimeZone=UTC", "extra_float_digits=0"]}, "public.submit_claim_reconciliation(uuid,boolean,uuid)": {"hash": "de0e779f604cf9fc5459ca58b6f86ee0", "owner": "postgres", "definer": true, "acl": "{postgres=X/postgres,authenticated=X/postgres}", "config": ["search_path=pg_catalog, pg_temp"]}, "public.submit_claim_reconciliation_v2(uuid,boolean,integer,bigint,uuid)": {"hash": "07be1bb35ed84b21f9acda69b7c35b16", "owner": "postgres", "definer": true, "acl": "{postgres=X/postgres,authenticated=X/postgres}", "config": ["search_path=pg_catalog, pg_temp"]}, "public.submit_route_resolution_evidence(uuid,uuid,text,bigint,uuid)": {"hash": "7122f77ea8ed84d28bc08fbf77192d40", "owner": "postgres", "definer": true, "acl": "{postgres=X/postgres,authenticated=X/postgres}", "config": ["search_path=pg_catalog, pg_temp"]}}$expected$::jsonb;
	 e record; p record; target oid; definition text; old_body text; new_body text; meta jsonb; actual jsonb;
