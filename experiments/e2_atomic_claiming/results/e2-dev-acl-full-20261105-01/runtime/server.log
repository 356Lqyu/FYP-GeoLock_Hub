	 IF EXISTS(SELECT 1 FROM pg_index i JOIN pg_attribute a ON a.attrelid=i.indrelid AND a.attnum=ANY(i.indkey::smallint[]) WHERE i.indrelid='public.listings'::regclass AND i.indisunique AND a.attname IN ('listing_status','listing_version')) THEN RAISE EXCEPTION 'LISTING_KEY_DRIFT'; END IF;
